# em .lua/.ini/.txt/.dat) esta no monorepo heldergaraujo2/Muserver. Aqui a regra e simples e
# conservadora: NAO converter nada (uma politica "que parece certa para Windows" reescreveria
# arquivos de evidencia na primeira checkout limpa).

* -text

# binarios de fato
*.bundle binary
*.exe binary
*.dll binary
*.dmp binary
*.bak binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# o bundle de backup sai byte a byte do clone: o sha256 e conferido por scripts/verify-backup.sh
workspace/backups/*.bundle binary
