-- =========================
-- FUNÇÃO PRINCIPAL DE DANO
-- =========================
function TemplateScript_OnUserDamage(aIndex, bIndex, damage, skill, combo, flag)
    if not eventActive or not aIndex or not bIndex then
        return 0
    end

    local attackerClass = GetObjectClass(aIndex) or 0
    local targetClass   = GetObjectClass(bIndex) or 0

    -- Skill Multiplier
    local skillMult = 2.0
    if SkillDamageConfig[attackerClass]
        and SkillDamageConfig[attackerClass][skill]
        and SkillDamageConfig[attackerClass][skill][targetClass] then
        skillMult = SkillDamageConfig[attackerClass][skill][targetClass]
    end

    -- Combo Multiplier
    local comboMult = 1.0
    if flag & 128 == 128 then
        comboMult = ComboBalance[attackerClass][targetClass] or 1.0
    end

    return math.floor(damage * skillMult * comboMult + 0.5)
end

-- =========================
-- REGISTRAR BRIDGE
-- =========================
BridgeFunctionAttach('OnUserDamage','TemplateScript_OnUserDamage')